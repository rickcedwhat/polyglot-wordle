rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Users Collection ---
    // Users can read anyone's public profile (for finding friends),
    // but can only create and update their own document.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth.uid == userId;
      allow delete: if false; // Disallow deleting users from the client

      match /friendships/{friendId} {
        allow read: if request.auth != null;

        // The create rule is correct from before.
        allow create: if
          (request.auth.uid == userId && request.resource.data.direction == 'outgoing') ||
          (request.auth.uid == friendId && request.resource.data.status == 'pending' && request.resource.data.direction == 'incoming');

        // Allow a user to UPDATE or DELETE a document if...
        allow update, delete: if
          // 1. They are modifying a friendship in their OWN list.
          request.auth.uid == userId ||
          // 2. OR they are the friend being referenced in the OTHER user's list.
          request.auth.uid == friendId;
      }

      // --- Vocabulary Collection ---
      // Users track their own discovered words; anyone signed in can view them on a profile.
      match /vocabulary/{lang} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // --- Games Collection ---
    match /games/{gameDocId} {
      // --- READ RULES ---
      // Any signed-in player can see anyone's games (friends' boards, profiles, challenges).
      allow read: if request.auth != null;

      // --- WRITE RULES ---
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow delete: if false;
    }
    
    // --- Invites Collection ---
    match /invites/{inviteId} {
      // Anyone can read an invite to see the landing page.
      allow read: if true;

      // Only a logged-in user can create an invite for themselves.
      allow create: if request.auth != null &&
                       request.auth.uid == request.resource.data.challengerId;

      // Only a logged-in user can update an invite (to claim it).
      allow update: if request.auth != null;
    }

    // --- Challenges Collection ---
    // 1v1 duel records for share links (and future in-app friend invites).
    match /challenges/{challengeId} {
      function isParticipant() {
        return request.auth != null && request.auth.uid in resource.data.participantIds;
      }

      function hasValidParticipants(data) {
        return data.participantIds is list &&
               data.participantIds.size() == 2 &&
               data.participantIds[0] != data.participantIds[1] &&
               data.participants is map &&
               data.participants.keys().hasOnly(data.participantIds) &&
               data.participants.keys().hasAll(data.participantIds);
      }

      function hasValidChallengeShape(data) {
        return data.keys().hasAll([
                 'gameId', 'createdAt', 'createdBy', 'source', 'type', 'maxPlayers',
                 'status', 'participants', 'participantIds', 'winnerId'
               ]) &&
               data.keys().hasOnly([
                 'gameId', 'createdAt', 'createdBy', 'source', 'type', 'maxPlayers',
                 'status', 'participants', 'participantIds', 'winnerId'
               ]);
      }

      function hasValidParticipantShape(participant) {
        return participant.keys().hasAll([
                 'displayName', 'photoURL', 'score', 'rsvp', 'completedAt', 'resultSeenAt'
               ]) &&
               participant.keys().hasOnly([
                 'displayName', 'photoURL', 'score', 'rsvp', 'completedAt', 'resultSeenAt'
               ]);
      }

      function bothPlayersFinished(data) {
        return data.participants[data.participantIds[0]].score is number &&
               data.participants[data.participantIds[1]].score is number;
      }

      function hasValidWinner(data) {
        let firstId = data.participantIds[0];
        let secondId = data.participantIds[1];
        let firstScore = data.participants[firstId].score;
        let secondScore = data.participants[secondId].score;
        return (firstScore == secondScore && data.winnerId == 'tie') ||
               (firstScore > secondScore && data.winnerId == firstId) ||
               (secondScore > firstScore && data.winnerId == secondId);
      }

      function hasValidResultState() {
        return bothPlayersFinished(request.resource.data)
          ? request.resource.data.status == 'completed' &&
            hasValidWinner(request.resource.data)
          : request.resource.data.status != 'completed' &&
            request.resource.data.winnerId == resource.data.winnerId;
      }

      function hasValidStatusTransition() {
        return request.resource.data.status == resource.data.status ||
               (resource.data.status == 'pending' &&
                request.resource.data.status == 'active' &&
                request.resource.data.participants[request.auth.uid].rsvp == 'accepted') ||
               (resource.data.status != 'completed' &&
                request.resource.data.status == 'completed');
      }

      function isValidClientCreate() {
        let data = request.resource.data;
        return request.auth != null &&
               hasValidChallengeShape(data) &&
               hasValidParticipants(data) &&
               hasValidParticipantShape(data.participants[data.createdBy]) &&
               hasValidParticipantShape(data.participants[request.auth.uid]) &&
               request.auth.uid in data.participantIds &&
               data.createdBy in data.participantIds &&
               request.auth.uid != data.createdBy &&
               data.createdAt == request.time &&
               data.source == 'share' &&
               data.type == 'direct' &&
               data.maxPlayers == 2 &&
               data.status == 'active' &&
               data.winnerId == null &&
               data.participants[data.createdBy].rsvp == 'accepted' &&
               data.participants[data.createdBy].resultSeenAt == null &&
               data.participants[request.auth.uid].score == null &&
               data.participants[request.auth.uid].rsvp == 'accepted' &&
               data.participants[request.auth.uid].completedAt == null &&
               data.participants[request.auth.uid].resultSeenAt == null &&
               challengeId == data.createdBy + '_' + data.gameId + '_' + request.auth.uid &&
               exists(/databases/$(database)/documents/games/$(data.createdBy + '_' + data.gameId)) &&
               get(/databases/$(database)/documents/games/$(data.createdBy + '_' + data.gameId)).data.userId == data.createdBy &&
               get(/databases/$(database)/documents/games/$(data.createdBy + '_' + data.gameId)).data.gameId == data.gameId &&
               data.participants[data.createdBy].score == get(/databases/$(database)/documents/games/$(data.createdBy + '_' + data.gameId)).data.score &&
               data.participants[data.createdBy].completedAt == get(/databases/$(database)/documents/games/$(data.createdBy + '_' + data.gameId)).data.completedAt &&
               exists(/databases/$(database)/documents/games/$(request.auth.uid + '_' + data.gameId)) &&
               get(/databases/$(database)/documents/games/$(request.auth.uid + '_' + data.gameId)).data.userId == request.auth.uid &&
               get(/databases/$(database)/documents/games/$(request.auth.uid + '_' + data.gameId)).data.gameId == data.gameId &&
               get(/databases/$(database)/documents/games/$(request.auth.uid + '_' + data.gameId)).data.guessHistory.size() > 0;
      }

      // In-app challenge: the challenger invites an accepted friend who hasn't played this game.
      // Post-game invites copy the challenger's finished score; new-game invites start at null.
      function isValidFriendInviteCreate() {
        let data = request.resource.data;
        let me = request.auth.uid;
        let friendId = data.participantIds[0] == me ? data.participantIds[1] : data.participantIds[0];
        let myGamePath = /databases/$(database)/documents/games/$(me + '_' + data.gameId);
        let friendshipPath = /databases/$(database)/documents/users/$(me)/friendships/$(friendId);
        return request.auth != null &&
               hasValidChallengeShape(data) &&
               hasValidParticipants(data) &&
               hasValidParticipantShape(data.participants[me]) &&
               hasValidParticipantShape(data.participants[friendId]) &&
               data.createdBy == me &&
               me in data.participantIds &&
               data.gameId is string &&
               data.gameId.size() <= 64 &&
               challengeId == me + '_' + data.gameId + '_' + friendId &&
               data.createdAt == request.time &&
               data.source == 'friend_invite' &&
               data.type == 'direct' &&
               data.maxPlayers == 2 &&
               data.status == 'pending' &&
               data.winnerId == null &&
               exists(friendshipPath) &&
               get(friendshipPath).data.status == 'accepted' &&
               !exists(/databases/$(database)/documents/games/$(friendId + '_' + data.gameId)) &&
               data.participants[me].rsvp == 'accepted' &&
               data.participants[me].resultSeenAt == null &&
               (exists(myGamePath)
                 ? data.participants[me].score == get(myGamePath).data.score &&
                   data.participants[me].completedAt == get(myGamePath).data.completedAt
                 : data.participants[me].score == null &&
                   data.participants[me].completedAt == null) &&
               data.participants[friendId].score == null &&
               data.participants[friendId].rsvp == 'pending' &&
               data.participants[friendId].completedAt == null &&
               data.participants[friendId].resultSeenAt == null;
      }

      function ownParticipantScoreLocked() {
        let oldMe = resource.data.participants[request.auth.uid];
        let newMe = request.resource.data.participants[request.auth.uid];
        return oldMe.score == null ||
               (newMe.score == oldMe.score && newMe.completedAt == oldMe.completedAt);
      }

      // After the duel is completed, only the caller's resultSeenAt may change.
      function isPostCompletionSeenUpdate() {
        let oldMe = resource.data.participants[request.auth.uid];
        let newMe = request.resource.data.participants[request.auth.uid];
        return resource.data.status == 'completed' &&
               request.resource.data.status == 'completed' &&
               request.resource.data.winnerId == resource.data.winnerId &&
               request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['participants']) &&
               request.resource.data.participants.diff(resource.data.participants).affectedKeys()
                 .hasOnly([request.auth.uid]) &&
               newMe.score == oldMe.score &&
               newMe.completedAt == oldMe.completedAt &&
               newMe.rsvp == oldMe.rsvp &&
               newMe.displayName == oldMe.displayName &&
               newMe.photoURL == oldMe.photoURL;
      }

      function isValidActiveDuelUpdate() {
        return resource.data.status != 'completed' &&
               hasValidParticipants(request.resource.data) &&
               request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['participants', 'winnerId', 'status']) &&
               request.resource.data.participants.diff(resource.data.participants).affectedKeys()
                 .hasOnly([request.auth.uid]) &&
               ownParticipantScoreLocked() &&
               (resource.data.participants[request.auth.uid].score != null ||
                request.resource.data.participants[request.auth.uid].score ==
                  get(/databases/$(database)/documents/games/$(request.auth.uid + '_' + resource.data.gameId)).data.score) &&
               hasValidStatusTransition() &&
               hasValidResultState();
      }

      function isValidClientUpdate() {
        return isParticipant() &&
               (isPostCompletionSeenUpdate() || isValidActiveDuelUpdate());
      }

      // A direct get may probe a deterministic ID before the challenge exists.
      allow get: if request.auth != null &&
                   (!exists(/databases/$(database)/documents/challenges/$(challengeId)) ||
                    request.auth.uid in resource.data.participantIds);

      // The createdBy clause lets the challenger query all challenges they sent on one game.
      allow list: if isParticipant() ||
                    (request.auth != null && resource.data.createdBy == request.auth.uid);

      // Trusted Admin SDK writes bypass these client rules.
      allow create: if isValidClientCreate() || isValidFriendInviteCreate();

      allow update: if isValidClientUpdate();

      // The challenger may withdraw an in-app invite until the friend starts playing it.
      allow delete: if request.auth != null &&
                       request.auth.uid == resource.data.createdBy &&
                       resource.data.source == 'friend_invite' &&
                       resource.data.status == 'pending';
    }

    // --- Word Flags Collection ---
    // Players flag dictionary words (missing, bad definition, ...) for review. The id is
    // `{uid}_{lang}_{wordKey}`. Reviewing everyone's flags is done with the Admin SDK.
    match /wordFlags/{flagId} {
      function isOwnFlagId() {
        return request.auth != null && flagId.matches(request.auth.uid + '_.+');
      }

      function isValidFlag(data) {
        return data.keys().hasOnly(['uid', 'lang', 'wordKey', 'display', 'note', 'reason', 'flaggedAt']) &&
               data.keys().hasAll(['uid', 'lang', 'wordKey', 'display', 'note', 'reason', 'flaggedAt']) &&
               data.uid == request.auth.uid &&
               data.lang in ['en', 'es', 'fr', 'it', 'pt'] &&
               data.wordKey is string && data.wordKey.size() > 0 && data.wordKey.size() <= 32 &&
               flagId == data.uid + '_' + data.lang + '_' + data.wordKey &&
               data.display is string && data.display.size() <= 32 &&
               data.note is string && data.note.size() <= 500 &&
               data.reason in ['missing', 'other'] &&
               data.flaggedAt is timestamp;
      }

      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create, update: if isOwnFlagId() && isValidFlag(request.resource.data);
      allow delete: if isOwnFlagId();
    }
  }
}
